{
  "name": "economy-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:ingest-inflation-contribution": "tsx scripts/bls/ingestInflationContributionRelease.ts",
    "data:ingest-inflation-contribution-history": "tsx scripts/bls/ingestInflationContributionHistory.ts",
    "data:ingest-category-cpi": "tsx scripts/bls/ingestCategoryCpiSeries.ts",
    "data:refresh-job-growth-breakeven": "tsx scripts/refreshJobGrowthBreakevenData.ts",
    "data:refresh": "tsx scripts/refreshEconomicData.ts",
    "lint": "eslint .",
    "perf:measure": "tsx scripts/perf/measure.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
